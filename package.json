{
  "name": "playmonkey",
  "version": "0.0.0",
  "description": "Seeded, LLM-assisted monkey testing for websites in test environments, built on Playwright.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/besessener/PlayMonkey.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "monkey": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "biome ci . && npm run typecheck",
    "format": "biome check --write ."
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "playwright": "^1.64.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
