{
  "name": "playmonkey",
  "version": "0.5.0",
  "description": "Seeded, LLM-assisted monkey testing for websites in test environments, built on Playwright.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/besessener/PlayMonkey.git"
  },
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "monkey": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli/main.js', 0o755)\"",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=97 --test-coverage-branches=88 --test-coverage-functions=93 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"test/**/*.test.ts\"",
    "lint": "biome ci . && npm run typecheck",
    "knip": "knip",
    "format": "biome check --write .",
    "check": "npm run lint && npm run knip && npm run test:coverage",
    "fixture": "node fixtures/site/start.ts"
  },
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^0.5.4",
    "@anthropic-ai/sdk": "^0.133.0",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "openai": "^7.32.0",
    "playwright": "^1.64.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "knip": "^6.41.0",
    "typescript": "^7.0.2"
  }
}
